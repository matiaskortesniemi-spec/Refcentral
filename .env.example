# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase — Settings > API in the dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses row level security. Server-side jobs only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Providers
AF_KEY=
FD_KEY=

# Optional: raise after upgrading to API-Football Pro
AF_RPM=8
FD_RPM=8
SEASON=2024
