{
  "name": "refcentral",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Referee performance ratings for the Premier League",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "tsx --env-file=.env.local scripts/smoketest.ts",
    "ingest:dry": "tsx --env-file=.env.local scripts/ingest.ts --dry-run",
    "ingest": "tsx --env-file=.env.local scripts/ingest.ts",
    "demo:rules": "tsx src/demo.ts",
    "demo:scoring": "tsx src/scoring/demo.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}